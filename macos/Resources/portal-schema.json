{
  "version": 1,
  "reasoning": {
    "maxRequests": 12,
    "maxFieldPasses": 3,
    "numericTextIntents": ["first_name", "last_name", "full_name", "email", "address_line_1", "address_line_2", "city", "county", "country", "company", "occupation"]
  },
  "autocomplete": {
    "email": "email",
    "tel": "phone",
    "tel-national": "phone",
    "tel-country-code": "phone_country_code",
    "given-name": "first_name",
    "family-name": "last_name",
    "name": "full_name",
    "postal-code": "postcode",
    "street-address": "address_line_1",
